# Giscus Configuration
# Obtener estos valores de https://giscus.app/ después de configurar GitHub Discussions
# 1. Ve a https://giscus.app/
# 2. Ingresa tu repositorio: flinodev/flinodev-page
# 3. Configura las opciones y copia los valores generados

GISCUS_REPO_ID=R_kgDOxxxxxx
GISCUS_CATEGORY_ID=DIC_kwDOxxxxxx

# Upstash Redis Configuration (para contador de vistas)
# 1. Ve a https://console.upstash.com/
# 2. Crea una cuenta gratuita
# 3. Crea una nueva base de datos Redis
# 4. Copia los valores de "REST API" → ".env"

UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxx

# Buttondown (formulario de suscripción — src/pages/api/subscribe.ts)
# 1. Ve a https://buttondown.com/settings/programming
# 2. Crea una key con permisos mínimos: Subscribers en "Read & write",
#    todo lo demás en None y Sending en Disabled.
# 3. Sin esta variable el endpoint responde 503 (nunca finge éxito).
#
# Se resuelve en tiempo de BUILD, no de ejecución: si la agregas en Vercel
# después de un deploy, hay que redesplegar para que tome efecto.

BUTTONDOWN_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
