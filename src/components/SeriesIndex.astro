---
import type { CollectionEntry } from "astro:content";
import { getSeries } from "@lib/series";

type Props = {
  entry: CollectionEntry<"blog">;
};

const { entry } = Astro.props;
const info = await getSeries(entry);

// El título de la serie ya encabeza la caja: repetirlo en cada fila deja
// "SQL básico - Clase 2" bajo un "SQL básico". Se recorta solo si coincide.
const label = (title: string) =>
  info && title.startsWith(info.title)
    ? title.slice(info.title.length).replace(/^\s*[-–—:·]\s*/, "") || title
    : title;
---

{
  info && (
    <nav
      aria-label={`Índice de la serie ${info.title}`}
      class="mt-12 p-5 rounded-lg border border-black/15 dark:border-white/20 bg-black/5 dark:bg-white/5"
    >
      <div class="text-sm uppercase opacity-75">Serie · {info.parts.length} partes</div>
      <h2 class="mt-1 text-lg font-semibold text-black dark:text-white">{info.title}</h2>
      <p class="mt-1 text-sm">{info.description}</p>

      <ol class="mt-4 flex flex-col gap-1">
        {info.parts.map((part) => {
          const isCurrent = part.id === entry.id;

          if (isCurrent) {
            return (
              <li
                aria-current="page"
                class="flex gap-3 px-3 py-2 rounded bg-black/10 dark:bg-white/10 text-black dark:text-white"
              >
                <div class="min-w-0">
                  <div class="font-semibold">{label(part.data.title)}</div>
                  <div class="text-sm opacity-75">{part.data.summary}</div>
                </div>
                {/* En móvil basta el fondo resaltado; la etiqueta robaría ancho al texto. */}
                <span class="ml-auto hidden pt-0.5 text-xs uppercase opacity-75 whitespace-nowrap sm:block">
                  Estás aquí
                </span>
              </li>
            );
          }

          return (
            <li class="flex gap-3">
              <a
                href={`/blog/${part.id}`}
                class="group flex gap-3 grow px-3 py-2 rounded hover:bg-black/5 hover:dark:bg-white/10 transition-colors duration-300 ease-in-out"
              >
                <div class="min-w-0 group-hover:text-black group-hover:dark:text-white transition-colors duration-300 ease-in-out">
                  <div class="font-semibold text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white transition-colors duration-300 ease-in-out">
                    {label(part.data.title)}
                  </div>
                  <div class="text-sm opacity-75">{part.data.summary}</div>
                </div>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
