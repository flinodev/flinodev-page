---
/**
 * Logotipo de marca — dirección "Cursor".
 *
 * Tres piezas alineadas al baseline: `flino` en peso 800, un cuadrado de señal
 * verde, y `dev` en peso 400. El cuadrado es a la vez el punto de `.dev` y el
 * cursor de la terminal — no es decoración, es la idea del logo.
 *
 * Todo se dimensiona en `em` para que el lockup escale con `size` sin tocar
 * proporciones: cuadrado 0.20em, margen inferior 0.18em (handoff del rebrand).
 */
type Props = {
  /** Tamaño del tipo en px. 20 en el header, 84 en el hero. */
  size?: number;
  class?: string;
};

const { size = 20, class: className = "" } = Astro.props;
---

<span
  class:list={["inline-flex items-end leading-none font-brand", className]}
  style={`font-size:${size}px`}
  aria-label="flino.dev"
>
  <span class="font-extrabold tracking-[-0.035em] text-black dark:text-white">flino</span>
  <span
    class="shrink-0 bg-signal"
    style="width:0.20em;height:0.20em;margin:0 0.08em 0.18em"
    aria-hidden="true"></span>
  <span class="font-normal text-black/55 dark:text-white/55">dev</span>
</span>
