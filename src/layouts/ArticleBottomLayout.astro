---
import { type CollectionEntry, render } from "astro:content";
import Giscus from "@/components/Giscus.astro";
import RelatedPosts from "@components/RelatedPosts.astro";
import SeriesIndex from "@components/SeriesIndex.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import SubscribeForm from "@/components/SubscribeForm";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

// Get the requested entry
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Check if comments are enabled for this post (defaults to true)
const showComments = data.comments !== false;
---

<div>
  <article>
    <Content />
  </article>

  {/* Al terminar de leer, el curso completo con la clase actual marcada. */}
  {entry.collection === "blog" && <SeriesIndex entry={entry} />}

  <ShareButtons title={data.title} />

  {/* Justo al terminar de leer: el momento de máxima intención. */}
  <SubscribeForm source="article" client:visible />

  {/* Sustituye al anterior/siguiente, que emparejaba por fecha y no por tema. */}
  <RelatedPosts entry={entry} />

  {
    showComments && (
      <div class="mt-12 pt-8 border-t border-black/10 dark:border-white/25">
        <h2 class="text-2xl font-semibold text-black dark:text-white mb-6">Comentarios</h2>
        <Giscus />
      </div>
    )
  }
</div>
